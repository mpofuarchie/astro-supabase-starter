---
interface Props {
  label: string;
  value: string;
  subValue?: string;
  trend?: 'positive' | 'negative' | 'neutral';
  icon?: string;
  description?: string;
}

const { label, value, subValue, trend = 'neutral', icon, description } = Astro.props;

const trendClasses = {
  positive: 'text-green-400',
  negative: 'text-red-400',
  neutral: 'text-white',
};
---

<div class="bg-neutral-700 rounded-xl p-5 flex flex-col gap-2 border border-neutral-600 hover:border-green-500/40 transition-colors">
  <div class="flex items-center justify-between">
    <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">{label}</span>
    {icon && <span class="text-lg select-none">{icon}</span>}
  </div>
  <div class={`text-2xl font-bold tabular-nums ${trendClasses[trend]}`}>{value}</div>
  {subValue && (
    <div class="text-sm text-neutral-400 tabular-nums">{subValue}</div>
  )}
  {description && (
    <div class="text-xs text-neutral-500 mt-1">{description}</div>
  )}
</div>
